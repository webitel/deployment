# {{ ansible_managed }}
apiVersion: 1
deleteDatasources: []
datasources:
  - name: "PostgreSQL Primary"
    uid: "webitel_pg_primary"
    type: "postgres"
    url: "{{ webitel_pg_host }}:{{ webitel_pg_port }}"
    user: "{{ grafana_datasource_user }}"
    secureJsonData:
      password: "{{ grafana_datasource_password }}"
    
    jsonData:
      database: "{{ webitel_pg_db }}"
      sslmode: "disable"
      maxOpenConns: 0
      maxIdleConns: 2
      connMaxLifetime: 14400
      postgresVersion: 1800
      timescaledb: true
    isDefault: {{ (grafana_datasource_default != 'replica') | lower }}
{% if webitel_pg_replica_host | length > 0 %}
  
  - name: "PostgreSQL Replica"
    uid: "webitel_pg_replica"
    type: "postgres"
    url: "{{ webitel_pg_replica_host }}:{{ webitel_pg_replica_port }}"
    user: "{{ grafana_datasource_user }}"
    secureJsonData:
      password: "{{ grafana_datasource_password }}"
    
    jsonData:
      database: "{{ webitel_pg_db }}"
      sslmode: "disable"
      maxOpenConns: 0
      maxIdleConns: 2
      connMaxLifetime: 14400
      postgresVersion: 1800
      timescaledb: true
    isDefault: {{ (grafana_datasource_default == 'replica') | lower }}
{% endif %}
