---
# Copy to vault.yml and encrypt it: ansible-vault encrypt group_vars/all/vault.yml
vault_webitel_repo_s3_access_key: CHANGE_ME
vault_webitel_repo_s3_secret_key: CHANGE_ME
vault_freeswitch_signalwire_key: pat_CHANGE_ME
vault_webitel_cookie_seed: CHANGE_ME_to_a_random_secret        # openssl rand -hex 32
vault_webitel_pg_password: CHANGE_ME_pg
vault_webitel_amqp_password: CHANGE_ME_amqp
vault_grafana_admin_password: CHANGE_ME_grafana_admin
vault_grafana_db_password: CHANGE_ME_grafana_db
vault_grafana_datasource_password: CHANGE_ME_grafana_ro
